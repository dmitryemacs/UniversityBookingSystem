# Database Configuration
# For local development:
DB_NAME=booking
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# For Railway deployment (automatically provided by Railway):
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DATABASE_USER=user
# DATABASE_PASSWORD=password

# Application
APP_PORT=8080
PORT=8080

# JWT Secret (change in production - use a strong random string!)
JWT_SECRET=mySecretKeyForJWTTokenGenerationMustBeLongEnough

# Frontend URL (update after deployment)
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional - for password reset)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# PGAdmin (optional - for local development only)
PGADMIN_PORT=8081
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
