# =========================================================
# Railway Database Configuration (automatically provided)
# =========================================================
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DATABASE_PUBLIC_URL=postgresql://user:password@public-host:port/dbname
# DATABASE_USER=user
# DATABASE_PASSWORD=password
# DATABASE_HOST=host
# DATABASE_PUBLIC_HOST=public-host
# DATABASE_PORT=5432
# DATABASE_NAME=dbname
#
# PostgreSQL convention (alternative):
# PGUSER=user
# PGPASSWORD=password
# PGDATABASE=dbname
# PGHOST=host
# PGPORT=5432

# Local development (fallback)
DB_NAME=booking
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Application
APP_PORT=8080
PORT=8080

# JWT Secret (change in production - use a strong random string!)
JWT_SECRET=mySecretKeyForJWTTokenGenerationMustBeLongEnough

# Frontend URL (update after deployment)
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional - for password reset)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# PGAdmin (optional - for local development only)
PGADMIN_PORT=8081
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
